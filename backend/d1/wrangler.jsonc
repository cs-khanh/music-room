{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "music-room-api-test",
  "main": "../worker.js",
  "compatibility_date": "2026-10-13",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "music-room-test-db",
      "database_id": "29297e37-b783-49cf-87b5-860444e0762b",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "MusicRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["MusicRoom"] }
  ],
  "observability": { "enabled": true }
}
